---
/**
 * LayoutIndex — every layout as a small still, linking to its LayoutReference.
 *
 *   <LayoutIndex />
 *
 * Links go to /reference/layouts/#layout-<name>, so the layouts reference page must hold a
 * <LayoutReference> for each (the coverage check enforces that).
 */
import "./deck.css";
import { Image } from "astro:assets";
import { caller, layoutAnchor, layouts, layoutSlide, slideStill, withBase } from "./data";

const c = caller("LayoutIndex", {}, Astro.url);
const items = layouts().map((layout) => {
  const shown = layoutSlide(c, layout.name);
  return { layout, still: slideStill(c, shown.deck, shown.slide.id) };
});
const page = withBase("/reference/layouts/");
---

<nav class="dk-layout-index" aria-label="Layouts">
  <ul>
    {items.map(({ layout, still }) => (
      <li>
        <a href={`${page}#${layoutAnchor(layout.name)}`} data-nb-zoom="off">
          <Image src={still.image} alt="" widths={[320, 480]} sizes="(min-width: 1100px) 180px, 45vw" loading="lazy" decoding="async" />
          <span class="dk-layout-index-name">{layout.name}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
