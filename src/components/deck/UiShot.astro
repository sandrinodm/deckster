---
/**
 * UiShot — a screenshot of the product, taken by scripts/docs/ui-shots.ts in deckster. Most are the deck
 * tools at 1440x900 in `deckster dev` on the showcase deck; `tools-detail` is a 560x200 crop of the
 * bottom-left corner at 2x (1120x400). The rest (see AGENT.md, "Staged shots"): `present-audience` and
 * `present-presenter` (the `deckster present` windows), `agent-turn` (a replayed turn, figures
 * recorded), `diff-report` (staged), `lint-before` and `lint-after` (a scratch slide, 1920x1080),
 * `build-gallery` (a `deckster build --all` gallery) and `export-verify` (one `--verify` comparison
 * picture, rearranged by the sync from one row of three panels into two rows, 1920x1160).
 *
 *   <UiShot name="presenter" alt="The presenter window: the current slide, the next one and the notes." />
 *
 * Names: sidebar, overview, help, presenter, comments, comment-list, tools, tools-detail, agent-panel,
 * agent-turn, present-audience, present-presenter, diff-report, lint-before, lint-after,
 * build-gallery, export-verify.
 */
import "./deck.css";
import { Image } from "astro:assets";
import { caller, fail, uiShot } from "./data";

interface Props {
  name: string;
  /** A full sentence saying what the screenshot shows. */
  alt: string;
}

const { name, alt } = Astro.props;
const c = caller("UiShot", { name }, Astro.url);
if (!alt || !alt.trim()) fail(c, "alt", "is required: a full sentence saying what the screenshot shows.");
const { image } = uiShot(c, name);
---

<figure class="dk-ui">
  <Image
    src={image}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1100px) 760px, 100vw"
    loading="lazy"
    decoding="async"
  />
</figure>
