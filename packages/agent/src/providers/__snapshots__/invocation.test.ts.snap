    "web_search="disabled"",
    "-c",
    "sandbox_workspace_write.exclude_slash_tmp=true",
    "-c",
    "sandbox_workspace_write.exclude_tmpdir_env_var=true",
    "-c",
    "mcp_servers.deck.url="http://127.0.0.1:5661/__deck/mcp"",
    "-c",
    "mcp_servers.deck.bearer_token_env_var="DECK_MCP_TOKEN"",
