{
  "name": "@deckster/cli",
  "version": "0.10.1",
  "description": "deck: the command line for deckster, a code-first slide framework (dev server, lint, screenshots, build, PDF and PPTX export, presenter).",
  "keywords": [
    "cli",
    "deck",
    "mdx",
    "pdf",
    "pptx",
    "presentation",
    "slides"
  ],
  "homepage": "https://sandrinodm.github.io/deckster/",
  "bugs": "https://github.com/sandrinodm/deckster/issues",
  "license": "MIT",
  "author": "Sandrino Di Mattia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrinodm/deckster.git",
    "directory": "packages/cli"
  },
  "bin": {
    "deckster": "./src/bin.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "bin": {
      "deckster": "./dist/deckster.js"
    },
    "exports": {
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "test": "vp test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p fixtures/layouts-new",
    "prepack": "vp pack && node scripts/stage-framework.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@shikijs/magic-move": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "decode-named-character-reference": "catalog:",
    "effect": "catalog:",
    "elkjs": "catalog:",
    "fflate": "catalog:",
    "fontkit": "catalog:",
    "harfbuzzjs": "catalog:",
    "lottie-web": "catalog:",
    "parse5": "catalog:",
    "pdf-lib": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "catalog:",
    "saxes": "catalog:",
    "shiki": "catalog:",
    "tailwindcss": "catalog:",
    "unplugin-icons": "catalog:",
    "uqr": "catalog:",
    "vite": "catalog:",
    "wawoff2": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@deckster/agent": "workspace:*",
    "@deckster/brand": "workspace:*",
    "@deckster/comments": "workspace:*",
    "@deckster/engine": "workspace:*",
    "@deckster/export": "workspace:*",
    "@deckster/kit": "workspace:*",
    "@deckster/shell": "workspace:*",
    "@deckster/vite-plugin": "workspace:*",
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "electron": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
